# SIXDOGS settings. Copy this file to `.env` and fill in the two Discord lines.
# Nothing else is needed to start: without a game server the bot runs the Discord
# side only (/setup-server, the #roles menu, admin commands).
#
# This file is for running on your own PC or a plain Linux server. On Railway
# there is no .env file: the same names go in the service's Variables tab
# instead, and only the ones you actually need. See deploy/RAILWAY.md.
#
# `.env` is ignored by git on purpose. Never commit it, and never put the RCON
# password anywhere but your own `.env`.
#
# On Windows make sure the file is called `.env` and not `.env.txt`
# (File Explorer: View -> Show -> File name extensions).


# ---------------------------------------------------------------------------
# 1. Discord (required)
# ---------------------------------------------------------------------------

# Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=

# Right-click your server icon in Discord -> Copy Server ID.
# (Needs Developer Mode: Settings -> Advanced -> Developer Mode.)
DISCORD_GUILD_ID=


# ---------------------------------------------------------------------------
# 2. Game server (RCON)
# ---------------------------------------------------------------------------
# Leave these two exactly as they are until your host gives you the real values.
# The placeholders below are how the launcher knows there is no game server yet,
# so it starts in Discord-only mode instead of failing.
#
# Fill them in and restart to switch on /verify, faction roles, commander picks
# and the live board. You want `connected to WARDOGS RCON` in the output.
#
# The listener is plain HTTP. An https:// address will be refused, not "fixed".
# This password is the full-access RCON password. It stays on the machine that
# runs core. The bot never sees it and it is never logged.
RCON_URL=http://203.0.113.10:7777
RCON_PASSWORD=change-me

# Shared password between core and the bot. Left starting with "make-up", the
# launcher generates a fresh random one on every start, which is what you want.
# Set a fixed value only if you run core and the bot on different machines.
INTERNAL_TOKEN=make-up-a-long-random-password-here


# ---------------------------------------------------------------------------
# 3. Database
# ---------------------------------------------------------------------------
# Empty = the built-in database (files in `data/`). Nothing to install.
# Point it at a real Postgres only if you want one, for example
# postgres://sixdogs:yourpassword@localhost:5432/sixdogs
DATABASE_URL=

# Only used by docker-compose.yml. Ignore this if you start with start.bat or
# `node run.mjs`.
POSTGRES_PASSWORD=


# ---------------------------------------------------------------------------
# 4. Website live status (optional)
# ---------------------------------------------------------------------------
# Sends a small public summary (no Discord IDs) to the Cloudflare Worker that
# feeds the "On the server now" section of sixdogs.gg. Setup is step 4 of
# website/DEPLOY.md. Leave empty to turn the section off.
STATUS_PUSH_URL=
STATUS_PUSH_TOKEN=
#STATUS_PUSH_MINUTES=2


# ---------------------------------------------------------------------------
# 5. Everything below is optional
# ---------------------------------------------------------------------------
# The defaults are shown. Uncomment a line only to change it.

# --- Live board in #server-info ---
# What players type into "Join by ID". Default: whatever RCON reports.
#GAME_SERVER_ID=
# Button link on the board. Default: the WARDOGS Steam page.
#JOIN_URL=
# Short link to your Discord invite. Default: the `domain` in community.json.
#INVITE_DOMAIN=sixdogs.gg
#LIVE_BOARD_MINUTES=5

# --- Names the bot uses ---
#BOT_NAME=SIXDOGS
#LOG_CHANNEL_NAME=admin-log
#MEMBER_ROLE_NAME=Member
#VERIFIED_ROLE_NAME=Verified
#COMMANDER_POOL_ROLE_NAME=Commander Pool
#ROLES_CHANNEL_NAME=roles

# --- Timing ---
# How often the bot asks core for the current state. Minimum 3000.
#SYNC_INTERVAL_MS=5000
# How long someone keeps a faction role after leaving that side.
#LEAVE_GRACE_SEC=60
# If the game server goes away, change nothing for this long, then clear the
# team and commander roles once.
#OUTAGE_CLEAR_MIN=10

# --- Commanders ---
#COMMANDER_DELAY_SEC=90
#COMMANDER_ACCEPT_SEC=60
# Commander loses the job after this long off the server.
#COMMANDER_AWAY_SEC=300

# --- Post-match ratings ---
# Commanded at least this long to be rated.
#RATING_MIN_SERVE_MIN=5
# Played on that faction this long to get a vote.
#RATING_MIN_PLAY_MIN=5
# How long a ballot stays open. Core and the bot must agree, so this one file
# sets both.
#RATING_VOTE_MINUTES=30
# Most commanders rated per faction per match.
#RATING_MAX_PER_FACTION=3
# How far back scores are counted.
#RATING_WINDOW_DAYS=60

# --- Scheduled operations ---
# Off while this is a 24/7 server. `true` brings the OPERATIONS category and the
# Operator role back.
#OPERATIONS_ENABLED=false

# --- Core polling ---
# Never poll faster than every 3 seconds.
#POLL_INTERVAL_MS=5000
#SLOW_POLL_INTERVAL_MS=10000
#HEALTH_CHECK_EVERY_MS=60000
#BACKPRESSURE_QUEUE_DEPTH=5
#RCON_TIMEOUT_MS=4000
#CORE_PORT=8080
#CORE_URL=http://core:8080
# How long a /verify code stays valid.
#VERIFY_CODE_TTL_SEC=600
#SAMPLE_RETENTION_DAYS=14
# Where the built-in database keeps its files.
#DATA_DIR=

# --- Faction names ---
# Rarely needed. Factions are recognised by the colour the server reports, then
# by the names Lonestar/Valkyra/Manticore. If the log says
# `unknown faction string "..."`, add it here:
#FACTION_ALIASES={"blue":["Team 1"],"red":["Team 2"],"green":["Team 3"]}
